# Copy to .env and adjust.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (docker compose up -d db)
# Use 127.0.0.1, not localhost: on Windows, localhost may hang on the IPv6 WSL port relay.
DATABASE_URL=postgresql+psycopg://resolveai:resolveai@127.0.0.1:5432/resolveai?connect_timeout=10

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON list
CORS_ORIGINS=["http://localhost:5173"]

# --- AI triage ---
# keyword: free local classifier (default). claude: Anthropic API, requires ANTHROPIC_API_KEY.
AI_PROVIDER=keyword
ANTHROPIC_API_KEY=
# claude-haiku-4-5 (cheapest, default) | claude-sonnet-5 | claude-opus-5 (most accurate)
AI_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max. Ignored by claude-haiku-4-5, which does not support it.
AI_EFFORT=low
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
# AI suggestions below this confidence are stored but not applied to the ticket.
AI_AUTO_APPLY_MIN_CONFIDENCE=0.7
AI_ANALYZE_ON_CREATE=true

# --- Knowledge base / RAG ---
# local: free offline lexical embeddings (default). voyage: semantic, requires VOYAGE_API_KEY
# (the first 200M tokens of voyage-4-lite are free per account).
# After switching provider or model, run POST /knowledge/reindex.
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_TIMEOUT_SECONDS=30
# Articles given to the answer generator.
RAG_TOP_K=3
# Minimum similarity for an article to count as relevant. Leave empty for the provider default
# (local 0.15, voyage 0.35).
RAG_MIN_SCORE=
AI_SUGGEST_ON_CREATE=true
